        && v.serieId==c.serieId && v.receitaId==c.receitaId && v.operacaoId==id;
    }
    function p9Marker(uid,id) {
      let m=request.resource.data; let r=getAfter(p9Path(uid,'operacoesParceladas',m.reversaoEventoId)).data;
      return m.keys().hasAll(['serieId','parcela','originalEventoId','reversaoEventoId','createdAt']) && m.keys().hasOnly(['serieId','parcela','originalEventoId','reversaoEventoId','createdAt'])
        && m.createdAt==request.time && m.originalEventoId==id && p9EventId(id) && r.tipo=='reverterPagamento'
        && r.comando.serieId==m.serieId && r.comando.parcela==m.parcela && r.comando.originalEventoId==id;
    }
    function p9Link(uid,id) {
      let m=request.resource.data; let r=getAfter(p9Path(uid,'operacoesParceladas',m.operacaoId)).data;
      return m.keys().hasAll(['serieId','receitaId','operacaoId','createdAt']) && m.keys().hasOnly(['serieId','receitaId','operacaoId','createdAt'])
        && m.createdAt==request.time && m.receitaId==id && safeId(id) && r.tipo=='vincularReceita' && r.comando.serieId==m.serieId && r.comando.receitaId==id;
    }
    function p9Use(uid,c,id) {
      let d=request.resource.data; let u=d.usoFinanceiro; let r=getAfter(p9Path(uid,'operacoesParceladas',u.eventoId)); let old=get(p9Path(uid,'operacoesParceladas',u.eventoId));
      return c in ['categorias','contas'] && resource.data.schemaVersion is int && resource.data.schemaVersion in [1,2] && validCatalogDoc(c,d) && resource.data.estado=='ativo' && !('usoFinanceiro' in resource.data)
        && d.diff(resource.data).affectedKeys().hasOnly(['schemaVersion','usoFinanceiro']) && d.schemaVersion==2 && old==null && r!=null
        && u.keys().hasAll(['eventoId','origemId','papel','createdAt']) && u.keys().hasOnly(['eventoId','origemId','papel','createdAt'])
        && u.createdAt==request.time && r.data.createdAt==request.time && u.origemId==(r.data.tipo=='substituirSerie' ? r.data.comando.novaSerieId:r.data.comando.serieId)
        && (c=='contas' ? u.papel=='movimentacao' && r.data.tipo=='pagarParcela' && r.data.fato.contaId==id
          : u.papel=='classificacao' && (r.data.tipo=='criarSerie' && r.data.comando.criacao.referencias.categoriaId==id
            || r.data.tipo=='editarParcelas' && r.data.comando.referencias.categoriaId==id
            || r.data.tipo=='substituirSerie' && r.data.comando.nova.referencias.categoriaId==id));
    }
    match /users/{uid}/seriesParceladas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit>=1 && request.query.limit<=50;
      allow create: if own(uid) && p9SeriesWrite(uid,id,true);
      allow update: if own(uid) && p9SeriesWrite(uid,id,false);
      allow delete: if false;
    }
    match /users/{uid}/validacoesParceladas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow create: if own(uid) && p9Witness(uid,id);
      allow list,update,delete: if false;
    }
    match /users/{uid}/operacoesParceladas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit>=1 && request.query.limit<=50;
      allow create: if own(uid) && p9Receipt(uid,id);
      allow update, delete: if false;
    }
    match /users/{uid}/reversoesParceladas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow create: if own(uid) && p9Marker(uid,id);
      allow list,update,delete: if false;
    }
    match /users/{uid}/vinculosReceitasEmprestimos/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow create: if own(uid) && p9Link(uid,id);
      allow list,update,delete: if false;
    }

    match /users/{uid}/faturas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit is int && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && catalogReady(uid) && invoiceDoc(request.resource.data) && invoiceMutation(uid,id,true);
      allow update: if own(uid) && catalogReady(uid) && invoiceDoc(request.resource.data) && invoiceMutation(uid,id,false);
      allow delete: if false;
    }
    match /users/{uid}/operacoesFaturas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit is int && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && invoiceReceiptShape(request.resource.data) && invoiceReceiptCreate(uid,id);
      allow update, delete: if false;
    }
    match /users/{uid}/cartoes/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit is int && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && catalogReady(uid) && safeId(id) && cardDoc(request.resource.data) && cardMutation(uid,id,true);
      allow update: if own(uid) && catalogReady(uid) && safeId(id) && cardDoc(request.resource.data) && cardMutation(uid,id,false);
      allow delete: if false;
    }
    match /users/{uid}/operacoesCartoes/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit is int && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && cardReceiptShape(request.resource.data) && cardReceiptCreate(uid,id);
      allow update, delete: if false;
    }
    match /users/{uid}/lancamentosExternos/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit != null && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && catalogReady(uid) && externalOriginCreate(uid,id);
      allow update, delete: if false;
    }
    match /users/{uid}/operacoesExternas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit != null && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && externalReceiptCreate(uid,id);
      allow update, delete: if false;
    }
    match /users/{uid}/reversoesExternas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list, write: if false;
    }

    match /users/{uid}/titulares/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit != null && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && catalogReady(uid) && catalogMutation(uid,'titulares',id,true);
      allow update: if own(uid) && catalogReady(uid) && catalogMutation(uid,'titulares',id,false);
      allow delete: if false;
    }
    match /users/{uid}/categorias/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit != null && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && catalogReady(uid) && catalogMutation(uid,'categorias',id,true);
      allow update: if own(uid) && (usePatch() ? (p9EventId(request.resource.data.usoFinanceiro.eventoId) ? p9Use(uid,'categorias',id) : financialUsePatch(uid,'categorias',id)) : catalogReady(uid) && catalogMutation(uid,'categorias',id,false));
      allow delete: if false;
    }
    match /users/{uid}/contas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit != null && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && catalogReady(uid) && catalogMutation(uid,'contas',id,true);
      allow update: if own(uid) && (usePatch() ? (p9EventId(request.resource.data.usoFinanceiro.eventoId) ? p9Use(uid,'contas',id) : financialUsePatch(uid,'contas',id)) : catalogReady(uid) && catalogMutation(uid,'contas',id,false));
      allow delete: if false;
    }
    match /users/{uid}/etiquetas/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list: if own(uid) && catalogReady(uid) && request.query.limit != null && request.query.limit >= 1 && request.query.limit <= 50;
      allow create: if own(uid) && catalogReady(uid) && catalogMutation(uid,'etiquetas',id,true);
      allow update: if own(uid) && catalogReady(uid) && catalogMutation(uid,'etiquetas',id,false);
      allow delete: if false;
    }
    match /users/{uid}/operacoesCadastros/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow create: if own(uid) && catalogReady(uid) && receiptCreate(uid,id);
      allow list, update, delete: if false;
    }
    match /users/{uid}/usoCadastros/{id} {
      allow get: if own(uid) && catalogReady(uid);
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if own(uid);
      allow create: if own(uid)
        && request.resource.data.keys().hasAll(['uid','timezone','schemaVersion','primeiro_login','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['uid','timezone','schemaVersion','primeiro_login','createdAt','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.timezone == 'America/Rio_Branco'
        && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1
        && request.resource.data.primeiro_login == true
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow list, update, delete: if false;
    }
    match /admins/{uid} {
      allow get: if own(uid) && ready();
      allow list, create, update, delete: if false;
    }
    match /registrationRequests/{id} {
      allow get: if admin() || (ready() && resource.data.applicantUid == request.auth.uid);
      allow list: if admin() && request.query.limit != null && request.query.limit <= 25;
      allow create, update, delete: if false;
    }
    match /subscriptions/{id} {
      allow get: if admin();
      allow create: if admin() && subscription(id) && request.resource.data.version == 1
        && request.resource.data.createdAt == request.time;
      allow update: if admin() && subscription(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startDate','endDate','version','updatedAt','updatedBy'])
        && request.resource.data.version == resource.data.version + 1;
      allow list, delete: if false;
    }
    match /notificationOutbox/{id} {
      allow get: if admin();
      allow list, create, update, delete: if false;
    }
    match /firstLoginOperations/{id} { allow read, write: if false; }
    match /submissionOperations/{id} { allow read, write: if false; }
    match /operationBudgets/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
