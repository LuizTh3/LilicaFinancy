{
  "name": "lilica-financy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.integration.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck:trusted-api": "npm run typecheck --workspace @lilica/trusted-api",
    "build:trusted-api": "npm run build --workspace @lilica/trusted-api"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "services/trusted-api"
  ],
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
