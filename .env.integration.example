# Modelo público, sem credenciais. Copie para .env.integration.local (ignorado).
# Copie estes quatro valores do .env do projeto escolhido para os testes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Confira o projectId independentemente no Console Firebase, sem usar o nome amigável.
TEST_EXPECTED_PROJECT_ID=
TEST_RUN_ID=externos-20261018-01
TEST_INTEGRATION_GROUP=externos
# Só alterar para yes depois de confirmar a publicação autorizada de Rules/índices.
TEST_RULES_CONFIRMED=no

# Quatro contas fictícias diferentes. UID vem de Authentication > Users.
# A/B/ADMIN concluem primeiro acesso e usam a senha definitiva, com novo login.
TEST_USER_A_UID=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_UID=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
TEST_USER_ADMIN_UID=
TEST_USER_ADMIN_EMAIL=
TEST_USER_ADMIN_PASSWORD=
# PENDING faz login uma vez e deixa a troca obrigatória de senha sem concluir.
TEST_USER_PENDING_UID=
TEST_USER_PENDING_EMAIL=
TEST_USER_PENDING_PASSWORD=
